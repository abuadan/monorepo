# Enable pip
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Configure how we fetch python dependencies via pip
pip.parse(
    environment = {
        "CFLAGS": "${CFLAGS:-}",
        "LDFLAGS": "${LDFLAGS:-}",
    },
    # Use the bazel downloader for pulling pypi packages.
    # experimental_index_url = "https://pypi.org/simple",
    # This name is what gets used in other BUILD files with `load()`.
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//python:requirements.lock",
    whl_modifications = {
        "@pip_whl_mods//:pygraphviz.json": "pygraphviz",
    },
)
pip.whl_mods(
    additive_build_content = """
load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "_graphviz_so",
    srcs = ["site-packages/pygraphviz/graphviz_wrap.c"],
    copts = ["-Wno-error", "-Isite-packages/pygraphviz"],
    linkopts = ["-undefined", "dynamic_lookup"],
    linkshared = True,
    deps = [
        "@@+http_archive+graphviz//:graphviz",
        "@@+http_archive+graphviz//:graphviz_public_headers",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)
""",
    copy_files = {
        ":_graphviz_so": "site-packages/pygraphviz/_graphviz.cpython-313-darwin.so",
    },
    data = [":_graphviz_so"],
    data_exclude_glob = ["site-packages/pygraphviz/_graphviz*.so"],
    hub_name = "pip_whl_mods",
    whl_name = "pygraphviz",
)

# Same as WORKSPACE install_deps() - actually install the python deps.
use_repo(pip, "pip", "pip_whl_mods")

